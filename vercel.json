{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "redirects": [
    { "source": "/ai-training", "destination": "/ai-training.html", "permanent": true },
    { "source": "/ai-training/", "destination": "/ai-training.html", "permanent": true },
    { "source": "/ai-training/custom", "destination": "/ai-training/custom.html", "permanent": true },
    { "source": "/ai-training/live-workflow-clinic", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/training", "destination": "/ai-training.html", "permanent": true },
    { "source": "/training.html", "destination": "/ai-training.html", "permanent": true },
    { "source": "/camp-claude", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/camp-claude.html", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/ai-training/camp-claude", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/ai-training/camp-claude.html", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/ai-training/live-ai-training-camp", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/ai-training/live-ai-training-camp/", "destination": "/ai-training/live-workflow-clinic.html", "permanent": true },
    { "source": "/assessment", "destination": "/contact.html", "permanent": true },
    { "source": "/assessment.html", "destination": "/contact.html", "permanent": true },
    { "source": "/survey-admin.html", "destination": "/", "permanent": false },
    { "source": "/assets/certificates/certificate-final.html", "destination": "/contact.html", "permanent": false },
    { "source": "/assets/certificates/certificate-final.pdf", "destination": "/contact.html", "permanent": false },
    { "source": "/tiktok.html", "destination": "/", "permanent": false },
    { "source": "/webinars", "destination": "/ai-training.html", "permanent": true },
    { "source": "/webinars/", "destination": "/ai-training.html", "permanent": true },
    { "source": "/webinars/educators", "destination": "/ai-training.html", "permanent": true },
    { "source": "/webinars/educators.html", "destination": "/ai-training.html", "permanent": true },
    { "source": "/research", "destination": "/insights/", "permanent": true },
    { "source": "/research.html", "destination": "/insights/", "permanent": true },
    { "source": "/resources", "destination": "/prompting.html", "permanent": true },
    { "source": "/resources.html", "destination": "/prompting.html", "permanent": true },
    { "source": "/case-studies/warren-county-esc-deck.html", "destination": "/case-studies/warren-county-esc.html", "permanent": true },
    { "source": "/certificates", "destination": "/ai-training.html", "permanent": true },
    { "source": "/certificates.html", "destination": "/ai-training.html", "permanent": true },
    { "source": "/certificates-business", "destination": "/ai-training.html", "permanent": true },
    { "source": "/certificates-business.html", "destination": "/ai-training.html", "permanent": true },
    { "source": "/certificates-education", "destination": "/ai-training.html", "permanent": true },
    { "source": "/certificates-education.html", "destination": "/ai-training.html", "permanent": true },
    { "source": "/get-certificate", "destination": "/contact.html", "permanent": true },
    { "source": "/get-certificate.html", "destination": "/contact.html", "permanent": true },
    { "source": "/state-partners", "destination": "/capabilities.html", "permanent": true },
    { "source": "/state-partners.html", "destination": "/capabilities.html", "permanent": true },
    { "source": "/nsf-techaccess", "destination": "/capabilities.html", "permanent": true },
    { "source": "/nsf-techaccess.html", "destination": "/capabilities.html", "permanent": true },
    { "source": "/studio", "destination": "/ai-training.html", "permanent": true },
    { "source": "/studio.html", "destination": "/ai-training.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
